#!/usr/bin/env php
<?php

declare(strict_types=1);

/**
 * karhu CLI entry point.
 *
 * Scans command classes and dispatches based on $argv.
 * Usage: bin/karhu <command> [options]
 */

// Find autoloader — works from both the framework repo and installed packages
$autoloadPaths = [
    __DIR__ . '/../vendor/autoload.php',          // framework repo
    __DIR__ . '/../../../autoload.php',            // installed as dependency
];

foreach ($autoloadPaths as $path) {
    if (file_exists($path)) {
        require $path;
        break;
    }
}

use Karhu\Cli\CommandDispatcher;
use Karhu\Container\Container;

$cwd = getcwd() ?: '.';

// If the host app defines a container config, load it BEFORE constructing the
// dispatcher so commands with typed ctor deps (interfaces, scalars-via-factory)
// can be resolved. The file may return:
//   - a Container instance              (fully built by the host)
//   - a callable(Container): void       (mutates a fresh container)
// If absent, the dispatcher uses an empty Container — same as before this
// file was added, so existing apps don't change behaviour.
$container = null;
$containerConfig = $cwd . '/config/container.php';
if (file_exists($containerConfig)) {
    $configured = require $containerConfig;
    if ($configured instanceof Container) {
        $container = $configured;
    } elseif (is_callable($configured)) {
        $container = new Container();
        $configured($container);
    }
}

$dispatcher = new CommandDispatcher($container);

// Scan built-in commands
$dispatcher->scanCommands([
    \Karhu\Cli\Commands\RouteCacheCommand::class,
]);

// If the host app defines a commands config, load it
$commandsConfig = $cwd . '/config/commands.php';
if (file_exists($commandsConfig)) {
    $classes = require $commandsConfig;
    if (is_array($classes)) {
        $dispatcher->scanCommands($classes);
    }
}

exit($dispatcher->dispatch($argv));
